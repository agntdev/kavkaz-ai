[
  {
    "name": "/start replies with the welcome + main menu",
    "steps": [
      {
        "send": { "text": "/start" },
        "expect": [
          {
            "method": "sendMessage",
            "payload": { "text": "👋 Добро пожаловать! Выберите действие в меню ниже.", "reply_markup": { "keyboard": [[{ "text": "Новый чат" }, { "text": "Мои чаты" }], [{ "text": "Изображения" }, { "text": "Файлы" }], [{ "text": "Поиск" }, { "text": "Голос" }], [{ "text": "Профиль" }, { "text": "Тариф" }]], "resize_keyboard": true, "one_time_keyboard": false, "input_field_placeholder": "Выберите действие" } }
          }
        ]
      }
    ]
  },
  {
    "name": "the main menu can be reopened from an inline button",
    "steps": [
      {
        "send": { "callback": "menu:main" },
        "expect": [
          {
            "method": "sendMessage",
            "payload": { "text": "👋 Добро пожаловать! Выберите действие в меню ниже.", "reply_markup": { "keyboard": [[{ "text": "Новый чат" }, { "text": "Мои чаты" }], [{ "text": "Изображения" }, { "text": "Файлы" }], [{ "text": "Поиск" }, { "text": "Голос" }], [{ "text": "Профиль" }, { "text": "Тариф" }]], "resize_keyboard": true, "one_time_keyboard": false, "input_field_placeholder": "Выберите действие" } }
          }
        ]
      }
    ]
  }
]
