[
  {
    "name": "profile language and retention controls",
    "steps": [
      { "send": { "callback": "menu:profile" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Ваш профиль\n\nИмя: Test\nЯзык: RU\nЧасовой пояс: UTC\nСообщений в этом месяце: 0" } }] },
      { "send": { "callback": "profile:language" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Язык изменён на EN." } }] },
      { "send": { "callback": "menu:settings" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Настройки\n\nХранить историю: 90 дней\nКороткие ответы: выключены" } }] },
      { "send": { "callback": "settings:retention:30" }, "expect": [{ "method": "sendMessage", "payload": { "text": "История будет храниться 30 дней." } }] }
    ]
  }
]
